# ProofPocket Environment Variables
# Copy this file to .env and provide your actual values.
# NEVER commit the real .env file or your MongoDB credentials to source control.

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/proofpocket?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/proofpocket?retryWrites=true&w=majority

# Optional: Override Database Name if not included in URI path
DB_NAME=proofpocket

# Server Port
PORT=5050

# JSON Web Token Secret key for signing sessions
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# JWT Expiration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development
